                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT        dbo.Animales.ID_Animal, dbo.Duenos.ID_Dueno , dbo.Historial_Medico.ID_Historial, dbo.Sedes.ID_Sede, dbo.Animales.Peso_Actual, dbo.Facturas.Total_Pagar, dbo.Citas.Temperatura, 
                         dbo.Facturas.ID_Factura
FROM            dbo.Animales INNER JOIN
                         dbo.Duenos ON dbo.Animales.ID_Dueno = dbo.Duenos.ID_Dueno INNER JOIN
                         dbo.Historial_Medico ON dbo.Animales.ID_Animal = dbo.Historial_Medico.ID_Animal INNER JOIN
                         dbo.Facturas ON dbo.Duenos.ID_Dueno = dbo.Facturas.ID_Dueno INNER JOIN
                         dbo.Sedes ON dbo.Facturas.ID_Sede = dbo.Sedes.ID_Sede INNER JOIN
                         dbo.Citas ON dbo.Animales.ID_Animal = dbo.Citas.ID_Animal AND dbo.Sedes.ID_Sede = dbo.Citas.ID_Sede</property>
                <property
                  dataType="System.String"
                  description="Variable que contiene el comando SQL para ejecutar."
                  name="SqlCommandVariable"></property>
