          SQLTask:Connection="{A95B0BCD-B562-44E0-A177-C8747EAB8409}"
          SQLTask:SqlStatementSource="USE [DW_Veterinaria]&#xA;GO&#xA;&#xA;/****** Object:  Table [dbo].[H_Consultas]    Script Date: 24/11/2026 10:24:49 a. m. ******/&#xA;SET ANSI_NULLS ON&#xA;GO&#xA;&#xA;SET QUOTED_IDENTIFIER ON&#xA;GO&#xA;&#xA;CREATE TABLE [dbo].[H_Consultas](&#xA;&#x9;[ID_Consulta] [int] IDENTITY(1,1) NOT NULL,&#xA;&#x9;[ID_Animal] [int] NOT NULL,&#xA;&#x9;[ID_Dueno] [int] NOT NULL,&#xA;&#x9;[ID_Historial] [int] NOT NULL,&#xA;&#x9;[ID_Sede] [int] NOT NULL,&#xA;&#x9;[ID_Tiempo] [int] NOT NULL,&#xA;&#x9;[Costo_Consulta] [decimal](10, 2) NULL,&#xA;&#x9;[Peso_Actual] [decimal](6, 2) NULL,&#xA;&#x9;[Temperatura] [decimal](4, 2) NULL,&#xA;PRIMARY KEY CLUSTERED &#xA;(&#xA;&#x9;[ID_Consulta] ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [PRIMARY]&#xA;) ON [PRIMARY]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[H_Consultas]  WITH CHECK ADD  CONSTRAINT [fk_Animal_Consultas] FOREIGN KEY([ID_Animal])&#xA;REFERENCES [dbo].[D_Animales] ([ID_Animal])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[H_Consultas] CHECK CONSTRAINT [fk_Animal_Consultas]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[H_Consultas]  WITH CHECK ADD  CONSTRAINT [fk_Dueno_Consultas] FOREIGN KEY([ID_Dueno])&#xA;REFERENCES [dbo].[D_Duenos] ([ID_Dueno])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[H_Consultas] CHECK CONSTRAINT [fk_Dueno_Consultas]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[H_Consultas]  WITH CHECK ADD  CONSTRAINT [fk_Historial_Consultas] FOREIGN KEY([ID_Historial])&#xA;REFERENCES [dbo].[D_Historial_Medic] ([ID_Historial])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[H_Consultas] CHECK CONSTRAINT [fk_Historial_Consultas]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[H_Consultas]  WITH CHECK ADD  CONSTRAINT [fk_Sede_Consultas] FOREIGN KEY([ID_Sede])&#xA;REFERENCES [dbo].[D_Sedes] ([ID_Sede])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[H_Consultas] CHECK CONSTRAINT [fk_Sede_Consultas]&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[H_Consultas]  WITH CHECK ADD  CONSTRAINT [fk_Tiempo_Consultas] FOREIGN KEY([ID_Tiempo])&#xA;REFERENCES [dbo].[D_Tiempo] ([ID_Tiempo])&#xA;GO&#xA;&#xA;ALTER TABLE [dbo].[H_Consultas] CHECK CONSTRAINT [fk_Tiempo_Consultas]&#xA;GO&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
